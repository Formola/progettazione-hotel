@startuml usecase_diagram
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
skinparam packageStyle rectangle
left to right direction
skinparam dpi 150
skinparam defaultFontSize 9
skinparam defaultFontName Arial

skinparam usecase {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #666666
    FontSize 8
    Shadowing false
}

skinparam package {
    BackgroundColor #F8F9FA
    BorderColor #333333
    FontSize 9
    FontStyle bold
}

skinparam actor {
    BackgroundColor White
    BorderColor #333333
    FontSize 8
}

' ACTORS - Compatti
actor "Guest" as Guest
actor "Auth User" as AuthUser
actor "Owner" as Owner
actor "Booker" as Booker

Guest <|-- AuthUser
AuthUser <|-- Owner
AuthUser <|-- Booker

' PACKAGES ORGANIZZATI IN MODO COMPATTO

package "Authentication" as PkgAuth {
    usecase "Sign Up" as SignUp
    usecase "Login" as Login
    usecase "Logout" as Logout
}

package "Property Search" as PkgSearch {
    usecase "Search Property" as SearchProp
    usecase "View Property Details" as ViewDetails
    usecase "Filter Results" as Filter
}

package "Property Management" as PkgProp {
    usecase "Access Owner Dashboard" as Dashboard
    usecase "Create New Property" as CreateProp
    usecase "Edit Property" as EditProp
    usecase "Delete Property" as DeleteProp
    usecase "Manage Property Content" as MngPropCont
    usecase "Add/Edit Basic Details" as BasicDetails
}

package "Room Management" as PkgRoom {
    usecase "Manage Rooms" as ManageRooms
    usecase "Add Room" as AddRoom
    usecase "Edit Room" as EditRoom
    usecase "Delete Room" as DeleteRoom
    usecase "Manage Room Content" as MngRoomCont
    usecase "Add/Edit Basic Room Details" as BasicRoomDetails
}

package "Amenities Management" as PkgAmen {
    usecase "Manage Property Amenities" as ManagePropAm
    usecase "Add Property Amenity" as AddPropAm
    usecase "Delete Property Amenity" as DelPropAm
    usecase "Add Custom Property Amenity" as CustPropAm
    usecase "Manage Room Amenities" as ManageRoomAm
    usecase "Add Room Amenity" as AddRoomAm
    usecase "Delete Room Amenity" as DelRoomAm
    usecase "Add Custom Room Amenity" as CustRoomAm
}

package "Media Management" as PkgMedia {
    usecase "Manage Media" as ManageMedia
    usecase "Upload Media" as UploadMedia
    usecase "Delete Media" as DeleteMedia
}

' LAYOUT HINTS per organizzazione compatta
PkgAuth -[hidden]right-> PkgProp
PkgProp -[hidden]right-> PkgAmen
PkgSearch -[hidden]right-> PkgRoom
PkgRoom -[hidden]right-> PkgMedia

PkgAuth -[hidden]down-> PkgSearch

' RELATIONS

' Auth
Guest --> SignUp
Guest --> Login
AuthUser --> Logout

' Search
Guest --> SearchProp
SearchProp <.. ViewDetails : <<extend>>
Filter ..> SearchProp : <<extend>>

' Property Management
Owner --> Dashboard
Dashboard <.. CreateProp : <<extend>>
Dashboard <.. EditProp : <<extend>>
Dashboard <.. DeleteProp : <<extend>>
CreateProp <.. MngPropCont : <<extend>>
EditProp <.. MngPropCont : <<extend>>
BasicDetails <.. MngPropCont : <<include>>

' Room Management
EditProp <.. ManageRooms : <<extend>>
ManageRooms <.. AddRoom : <<extend>>
ManageRooms <.. EditRoom : <<extend>>
ManageRooms <.. DeleteRoom : <<extend>>
AddRoom <.. MngRoomCont : <<extend>>
EditRoom <.. MngRoomCont : <<extend>>
BasicRoomDetails <.. MngRoomCont : <<include>>

' Amenities
MngPropCont ..> ManagePropAm : <<include>>
MngRoomCont ..> ManageRoomAm : <<include>>
ManagePropAm <.. AddPropAm : <<extend>>
ManagePropAm <.. DelPropAm : <<extend>>
AddPropAm <.. CustPropAm : <<extend>>
ManageRoomAm <.. AddRoomAm : <<extend>>
ManageRoomAm <.. DelRoomAm : <<extend>>
AddRoomAm <.. CustRoomAm : <<extend>>

' Media
MngPropCont ..> ManageMedia : <<include>>
MngRoomCont ..> ManageMedia : <<include>>
ManageMedia <.. UploadMedia : <<extend>>
ManageMedia <.. DeleteMedia : <<extend>>

@enduml