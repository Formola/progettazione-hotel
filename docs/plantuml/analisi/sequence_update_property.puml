@startuml sequence_update_property_final
skinparam style strictuml
skinparam sequenceMessageAlign center

actor PropertyOwner as Owner
participant Property as Prop
participant Room as R
participant Media as M
participant PropertyAmenity as PA
participant RoomAmenity as RA

' --- Edit Property triggered by Owner ---
Owner -> Prop: editProperty(details)
activate Prop
Prop --> Owner: propertyUpdated

' --- Manage Property Amenities ---
Prop -> PA: addOrUpdateAmenity(data)
activate PA
PA --> Prop: amenityUpdated
deactivate PA

' --- Upload Property Media ---
Prop -> M: uploadPropertyMedia(file)
activate M
M --> Prop: mediaSaved
deactivate M

' --- Manage Rooms ---
Prop -> R: updateRoom(details)
activate R
R --> Prop: roomUpdated

' --- Manage Room Amenities ---
R -> RA: addOrUpdateAmenity(data)
activate RA
RA --> R: roomAmenityUpdated
deactivate RA

' --- Upload Room Media ---
R -> M: uploadRoomMedia(file)
activate M
M --> R: mediaSaved
deactivate M

deactivate R
deactivate Prop

Owner -> Owner: viewProperties()
@enduml
