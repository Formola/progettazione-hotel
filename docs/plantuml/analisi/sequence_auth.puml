@startuml sequence_auth_strict
skinparam actorStyle awesome
skinparam style strictuml
skinparam sequenceMessageAlign center

actor UserActor as UA
participant User as U

' Declare lifelines upfront


' Signup
UA -> U: signup()
activate U
U -> U: enterData()
alt Data valid
    U --> UA: registration confirmed
else Data invalid
    U --> UA: request correction
end
deactivate U

' Login
UA -> U: login()
activate U
alt Credentials valid
    U --> UA: authentication success
else Credentials invalid
    U --> UA: show error / retry
end
deactivate U

' Logout
UA -> U: logout()
activate U
U --> UA: session terminated
deactivate U
@enduml
